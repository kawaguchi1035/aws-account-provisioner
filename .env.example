# Organizations 管理アカウントの AWS アカウント ID（12桁・必須）
ROOT_ACCOUNT_ID=123456789012

# 管理アカウントで引き受けるロール名（任意）
# 設定すると arn:aws:iam::${ROOT_ACCOUNT_ID}:role/${ASSUME_ROLE_NAME} を AssumeRole する。
# 未設定なら AssumeRole せず、プロファイルの認証情報をそのまま使う。
# ASSUME_ROLE_NAME=OrganizationAccountAccessRole

# --init がルートメールアドレスを導出するテンプレート（任意）
# {account_name} が小文字化したアカウント名に置換される。
# EMAIL_TEMPLATE=aws+{account_name}@example.com
